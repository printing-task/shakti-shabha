# Port for Render (Render will automatically set PORT in production)
PORT=5000

# MongoDB Atlas Connection String
# Replace <db_password> with your actual MongoDB Atlas database password
MONGODB_URI=mongodb+srv://printingtaskweb_db_user:<db_password>@cluster0.hqaggkf.mongodb.net/shakti_sabha?retryWrites=true&w=majority&compressors=zlib

# JWT Secret for Admin Authentication
JWT_SECRET=shakti_sabha_super_secret_jwt_key_change_me_in_production_2026

# Allowed Frontend Origins (Comma-separated)
CLIENT_ORIGIN=https://shakti-shabha.vercel.app,http://localhost:5173,http://localhost:3000

# Optional: Render Keep-Alive URL (if you want the server to self-ping itself every 5 minutes to prevent sleep)
# RENDER_EXTERNAL_URL=https://shakti-sabha-api.onrender.com
SELF_PING_INTERVAL_MS=300000

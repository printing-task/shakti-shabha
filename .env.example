# ==============================================================================
# FRONTEND CONFIGURATION (Render / Vercel / Local)
# NOTE: All frontend variables MUST start with "VITE_" so Vite bakes them in.
# IMPORTANT: On Render, after adding or changing environment variables, you MUST
# click "Manual Deploy" -> "Clear build cache & deploy" so Vite rebuilds the bundle!
# ==============================================================================

# Supabase Database & Auth (Optional client credentials)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
VITE_API_URL=https://shakti-shabha-1.onrender.com

# ------------------------------------------------------------------------------
# EMAILJS INTEGRATION (Notification to Admin on Form Submissions)
# ------------------------------------------------------------------------------
# Option A: Dedicated Keys (Recommended if using separate templates/services)

# 1. Courses & Cohort Inquiries
VITE_EMAILJS_SERVICE_ID_COURSES=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID_COURSES=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY_COURSES=public_key_xxxxxxx

# 2. Counselling & Mental Health Inquiries
VITE_EMAILJS_SERVICE_ID_COUNSELLING=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID_COUNSELLING=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY_COUNSELLING=public_key_xxxxxxx

# Option B: Global Fallback Keys (If using a single service or template for all forms)
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=public_key_xxxxxxx

# ==============================================================================
# BACKEND CONFIGURATION (Render Web Service)
# ==============================================================================
PORT=5000
MONGODB_URI=mongodb+srv://printingtaskweb_db_user:<db_password>@cluster0.hqaggkf.mongodb.net/shakti_sabha?retryWrites=true&w=majority&compressors=zlib
JWT_SECRET=your_super_secret_jwt_key
CLIENT_ORIGIN=https://shakti-shabha.vercel.app,http://localhost:5173,https://shakti-shabha-1.onrender.com
SELF_PING_INTERVAL_MS=300000

MONGODB_URI=mongodb+srv://printingtaskweb_db_user:<db_password>@cluster0.hqaggkf.mongodb.net/shakti_sabha?retryWrites=true&w=majority&compressors=zlib
JWT_SECRET=your_super_secret_jwt_key
